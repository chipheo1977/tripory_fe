# URL gốc của BE (server-only, không đặt tiền tố công khai của Next). Ví dụ BE chạy local:
API_ORIGIN=http://localhost:5000

# Origin công khai của CHÍNH web app (server-only). Tùy chọn: chỉ cần khi self-host sau reverse proxy ghi lại
# Host (nếu không, kiểm Origin chống CSRF so với địa chỉ nội bộ và mọi request ghi bị 403 Bff.CrossOrigin).
# Trên Vercel để trống. Chỉ một origin, không path; production phải là https (http chỉ cho localhost).
# APP_ORIGIN=https://app.example.com

# Bí mật dùng chung với BE (server-only, KHÔNG đặt tiền tố NEXT_PUBLIC_). BFF gửi nó cùng IP người dùng để BE
# giới hạn tốc độ login/register/refresh theo từng IP thay vì cả site chung một bucket. Tùy chọn: bỏ trống thì
# BFF không gửi header và BE đếm theo IP của server FE.
# Local: dùng đúng giá trị dưới đây để khớp appsettings.Development.json của BE. Production: dùng chuỗi ngẫu nhiên
# thật, đặt giống hệt trên Vercel (BFF_SHARED_SECRET) và BE (AuthRateLimitOptions:BffSharedSecret). Không commit.
# Bỏ dấu # ở dòng dưới khi chạy local (cố ý để comment để không vô tình mang giá trị dev lên production):
# BFF_SHARED_SECRET=dev-bff-secret-change-me
